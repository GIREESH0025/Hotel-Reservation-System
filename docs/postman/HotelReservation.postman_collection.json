{
  "info": {
    "_postman_id": "hrh-postman-coll-001",
    "name": "Harbour Row Hotel Reservation API",
    "description": "Comprehensive Postman collection for Harbour Row Hotel Reservation System (Project #8 MERN). Includes automated token extraction, auth tests, CRUD requests, overlap verification, and reports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aarav Mehta\",\n  \"email\": \"aarav@example.com\",\n  \"password\": \"Guest@1234\",\n  \"phone\": \"+91 98123 45678\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login (Admin) - Stores Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.environment.set(\"token\", res.data.token);",
                  "    console.log(\"Saved JWT token to environment\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Staff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.environment.set(\"token\", res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.environment.set(\"token\", res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "2. Room Types",
      "item": [
        {
          "name": "List Room Types",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/room-types", "host": ["{{baseUrl}}"], "path": ["room-types"] }
          }
        },
        {
          "name": "Get Room Type by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/room-types/{{roomTypeId}}", "host": ["{{baseUrl}}"], "path": ["room-types", "{{roomTypeId}}"] }
          }
        },
        {
          "name": "Create Room Type (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Executive Penthouse\",\n  \"description\": \"Top-floor suite with private terrace and butler.\",\n  \"baseRate\": 25000,\n  \"capacity\": 4,\n  \"amenities\": [\"Wi-Fi\", \"Air Conditioning\", \"Private Pool\", \"Terrace\", \"Smart TV\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/room-types", "host": ["{{baseUrl}}"], "path": ["room-types"] }
          }
        },
        {
          "name": "Update Room Type (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseRate\": 27000\n}"
            },
            "url": { "raw": "{{baseUrl}}/room-types/{{roomTypeId}}", "host": ["{{baseUrl}}"], "path": ["room-types", "{{roomTypeId}}"] }
          }
        },
        {
          "name": "Delete Room Type (Admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/room-types/{{roomTypeId}}", "host": ["{{baseUrl}}"], "path": ["room-types", "{{roomTypeId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Rooms",
      "item": [
        {
          "name": "Search Availability",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/rooms/availability?checkIn=2026-12-01&checkOut=2026-12-04&adults=2",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "availability"],
              "query": [
                { "key": "checkIn", "value": "2026-12-01" },
                { "key": "checkOut", "value": "2026-12-04" },
                { "key": "adults", "value": "2" }
              ]
            }
          }
        },
        {
          "name": "List All Rooms",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/rooms?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["rooms"] }
          }
        },
        {
          "name": "Get Room by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/rooms/{{roomId}}", "host": ["{{baseUrl}}"], "path": ["rooms", "{{roomId}}"] }
          }
        },
        {
          "name": "Create Room (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"801\",\n  \"floor\": 8,\n  \"roomType\": \"{{roomTypeId}}\",\n  \"status\": \"active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/rooms", "host": ["{{baseUrl}}"], "path": ["rooms"] }
          }
        },
        {
          "name": "Toggle Maintenance Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"maintenance\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/rooms/{{roomId}}", "host": ["{{baseUrl}}"], "path": ["rooms", "{{roomId}}"] }
          }
        },
        {
          "name": "Delete Room (Admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/rooms/{{roomId}}", "host": ["{{baseUrl}}"], "path": ["rooms", "{{roomId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Guests",
      "item": [
        {
          "name": "List Guests",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/guests?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["guests"] }
          }
        },
        {
          "name": "Get Guest by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/guests/{{guestId}}", "host": ["{{baseUrl}}"], "path": ["guests", "{{guestId}}"] }
          }
        },
        {
          "name": "Create Guest",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dr. Vikram Sengupta\",\n  \"phone\": \"+91 99000 88776\",\n  \"email\": \"vikram.sengupta@example.com\",\n  \"idProof\": \"Passport: K9876543\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/guests", "host": ["{{baseUrl}}"], "path": ["guests"] }
          }
        },
        {
          "name": "Update Guest",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+91 99000 99887\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/guests/{{guestId}}", "host": ["{{baseUrl}}"], "path": ["guests", "{{guestId}}"] }
          }
        }
      ]
    },
    {
      "name": "5. Reservations",
      "item": [
        {
          "name": "List Reservations",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reservations?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["reservations"] }
          }
        },
        {
          "name": "Get Reservation (with Folio Balance)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}"] }
          }
        },
        {
          "name": "Create Reservation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guestId\": \"{{guestId}}\",\n  \"roomId\": \"{{roomId}}\",\n  \"checkIn\": \"2026-12-10\",\n  \"checkOut\": \"2026-12-14\",\n  \"adults\": 2,\n  \"notes\": \"High floor requested, late arrival after 8 PM.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reservations", "host": ["{{baseUrl}}"], "path": ["reservations"] }
          }
        },
        {
          "name": "Confirm Reservation",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}/confirm", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}", "confirm"] }
          }
        },
        {
          "name": "Check-In Guest",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}/check-in", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}", "check-in"] }
          }
        },
        {
          "name": "Check-Out Guest (Fails if balance > 0)",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}/check-out", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}", "check-out"] }
          }
        },
        {
          "name": "Cancel Reservation",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/reservations/{{reservationId}}/cancel", "host": ["{{baseUrl}}"], "path": ["reservations", "{{reservationId}}", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "6. Payments",
      "item": [
        {
          "name": "List Payments",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/payments?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        },
        {
          "name": "Record Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationId\": \"{{reservationId}}\",\n  \"amount\": 5000,\n  \"method\": \"card\",\n  \"reference\": \"AUTH-987654\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        },
        {
          "name": "Refund Payment (Admin)",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/payments/{{paymentId}}/refund", "host": ["{{baseUrl}}"], "path": ["payments", "{{paymentId}}", "refund"] }
          }
        }
      ]
    },
    {
      "name": "7. Reports",
      "item": [
        {
          "name": "Today Summary",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reports/summary", "host": ["{{baseUrl}}"], "path": ["reports", "summary"] }
          }
        },
        {
          "name": "Revenue Aggregation",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reports/revenue?from=2026-01-01&to=2026-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "revenue"],
              "query": [
                { "key": "from", "value": "2026-01-01" },
                { "key": "to", "value": "2026-12-31" }
              ]
            }
          }
        },
        {
          "name": "Chamber Occupancy by Type",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reports/occupancy", "host": ["{{baseUrl}}"], "path": ["reports", "occupancy"] }
          }
        }
      ]
    },
    {
      "name": "8. Users Management (Admin)",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Change User Role",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"receptionist\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          }
        }
      ]
    }
  ]
}
