# Backend Environment Variables
# Copy this to .env and fill in real values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hotel_reservation?retryWrites=true&w=majority

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# CORS — set this to your frontend URL in production
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting (requests per 15 minutes per IP on auth routes)
AUTH_RATE_LIMIT=20

